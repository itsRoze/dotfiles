# Keep Kitty installed as a fallback; Ghostty is the daily driver.
font-family = CaskaydiaCove Nerd Font Mono
font-size = 14
font-thicken = true
font-thicken-strength = 15

# Everforest Dark Soft, shared with the Kitty fallback.
foreground = #d3c6aa
background = #333c43
selection-foreground = #d3c6aa
selection-background = #4f5b58
cursor-color = #dbbc7f
cursor-text = #3a464c
palette = 0=#343f44
palette = 8=#868d80
palette = 1=#e67e80
palette = 9=#e67e80
palette = 2=#a7c080
palette = 10=#a7c080
palette = 3=#dbbc7f
palette = 11=#dbbc7f
palette = 4=#7fbbb3
palette = 12=#7fbbb3
palette = 5=#d699b6
palette = 13=#d699b6
palette = 6=#83c092
palette = 14=#83c092
palette = 7=#859289
palette = 15=#9da9a0

background-opacity = 0.82
background-opacity-cells = true
background-blur = 24
minimum-contrast = 1.1

window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
macos-titlebar-style = hidden
macos-option-as-alt = left
macos-window-shadow = false

cursor-style = block
cursor-style-blink = false
scrollbar = never

# URLs remain selectable text; hold Command while clicking to open them.
link-url = true
link-previews = true
